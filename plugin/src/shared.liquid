{% template main %}
{% comment %} Masterworks: the artwork fills the view; no title bar. art.fit is cover (Fill) or contain (Whole work, on a plain white mat). {% endcomment %}
{% if art.url %}
{% assign show_label = true %}
{% if opts.label == "off" %}{% assign show_label = false %}{% endif %}
<div class="layout layout--center p--0">
  <div class="relative w--full h--full bg--white">
    <img src="{{ art.url }}" class="image image--{{ art.fit }} image-dither block w--full h--full" alt="{{ art.title | escape }}" />
    {% if show_label %}
    {% comment %} one inline font-size, the exception the framework allows for a value no class has: the Frame is screen--md at 1x like the OG, so no size class can tell 2560 px from 800 px; this scales with the layout (cqw) and never goes below the OG's own label size {% endcomment %}
    <div class="absolute bottom--3 left--3 z--2 px--3 py--2 bg--white outline flex flex--col flex--left text--left gap--none text--black" data-placard="1" style="font-size:max(15px,1.35cqw)">
      <span class="text--bold" data-clamp="2">{{ art.title | escape }}</span>
      <span class="text--regular" data-clamp="1">{{ art.artist | escape }}{% if art.year != blank %}, {{ art.year }}{% endif %}</span>
      {% if view == 1 or view == 2 %}{% if art.collection != blank %}<span class="text--regular" data-clamp="1">{{ art.collection | escape }}</span>{% endif %}{% endif %}
    </div>
    {% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title title--small">Masterworks</span>
  <span class="description">{{ notice | default: "No artwork available right now. The next refresh tries again." }}</span>
</div>
{% endif %}
{% endtemplate %}

{% comment %} Masterworks. No title bar. The "work" template draws one work; "main" draws the primary and, when there is one, a hidden backup (see main). Each work is drawn per view as "gallery" or "full" (geo[view].mode: the plugin's choice by how much a fill would crop). Gallery: the work on a pure white or black mat with no outline and a museum label (title, ARTIST and year, technique and where it hangs); full: the work fills the view with a small placard in its bottom-left corner. All text is Framework classes (title, label, size utilities, data-clamp) with the text colour on every element. The picture's width is the browser's choice (srcset and sizes): the renderer knows its viewport, the transform only the reported device. {% endcomment %}
{% template work %}
{% assign gv = geo[vname] %}
{% comment %} THE ONE PLACE that sizes text by screen. Known TRMNL bug: the Frame (2560 px, screen--frame) carries screen--md, not screen--lg, so lg: prefixes never apply to it and its Framework text is OG-sized on a 2560 px canvas. Until TRMNL fixes the class, a Frame (trmnl.device.model, or art.kind from the reported size) gets the largest Framework sizes; the X is lg and uses lg: prefixes. When the class is fixed, replace this branch with lg: prefixes and delete it. {% endcomment %}
{% if art.kind == "big" or trmnl.device.model == "frame" %}
  {% assign tcls = "title--xxlarge" %}{% assign acls = "label--xlarge" %}{% assign dcls = "label--large" %}{% assign lpad = "pt--4" %}{% assign ppad = "px--6 py--4" %}
{% else %}
  {% assign tcls = "title--small lg:title--base" %}{% assign acls = "label--small lg:label--base" %}{% assign dcls = "label--small" %}{% assign lpad = "pt--2" %}{% assign ppad = "px--3 py--2" %}
{% endif %}
{% assign inf = gv.info %}
{% comment %} mat and ink are pinned (dark: swaps the tokens back) so a dark-mode screen does not repaint the work's mat {% endcomment %}
{% if art.mat == "black" %}
  {% assign mat = "bg--black dark:bg--white" %}{% assign edge = "bg--white dark:bg--black" %}{% assign ink = "text--white dark:text--black" %}
{% else %}
  {% assign mat = "bg--white dark:bg--black" %}{% assign edge = "bg--black dark:bg--white" %}{% assign ink = "text--black dark:text--white" %}
{% endif %}
{% if gv.mode == "full" and inf %}
{% comment %} fill on and info on: the work fills the band above the strip edge to edge, from the top of the screen; the strip is full width under it on the mat's colour, its text inside the margins {% endcomment %}
<div class="layout layout--col gap--none p--0 {{ mat }}{% if block == "backup" %} hidden{% endif %}" data-mode="full" data-block="{{ block }}"{% if art.kind == "big" or trmnl.device.model == "frame" %} data-frame="1"{% endif %}>
  <div class="relative w--full h--[{{ inf.band }}cqh]" data-fill-band="1">
    <img src="{{ art.url }}" srcset="{{ art.srcset }}" sizes="100vw"{% if block == "backup" %} loading="lazy"{% elsif swap != blank %} onerror="{{ swap }}"{% endif %} class="image image--{{ gv.fit }} image-dither block w--full h--full" alt="" />
  </div>
  <div class="flex flex--col flex--bottom flex--center-x w--full h--[{{ 100 | minus: inf.band }}cqh] {{ mat }}">
    <div class="flex flex--row flex--bottom w--[{{ inf.stripw }}cqw]" data-info-block="below">
      {% render "info", inf:inf, info:info, art:art, ink:ink, frame:true %}
    </div>
    <div class="w--full h--[{{ inf.margin }}px]"></div>
  </div>
</div>
{% elsif gv.mode == "full" %}
<div class="layout layout--center p--0{% if block == "backup" %} hidden{% endif %}" data-mode="full" data-block="{{ block }}">
  <div class="relative w--full h--full bg--white">
    <img src="{{ art.url }}" srcset="{{ art.srcset }}" sizes="100vw"{% if block == "backup" %} loading="lazy"{% elsif swap != blank %} onerror="{{ swap }}"{% endif %} class="image image--{{ gv.fit }} image-dither block w--full h--full" alt="" />
    {% assign pl = gv.plate %}
    {% if pl %}
    {% comment %} the plate sits inside the picture's bottom-left corner with a margin (never across an edge): solid black with white text on a dark corner, solid white with black text on a light one, a thin solid edge in the other colour; dark: swaps the tokens back so a dark-mode screen does not repaint it {% endcomment %}
    {% if art.corner == "black" %}
      {% assign plate = "bg--black dark:bg--white" %}{% assign edge = "bg--white dark:bg--black" %}{% assign ink = "text--white dark:text--black" %}
    {% else %}
      {% assign plate = "bg--white dark:bg--black" %}{% assign edge = "bg--black dark:bg--white" %}{% assign ink = "text--black dark:text--white" %}
    {% endif %}
    <div class="absolute bottom--{{ pl.m }} left--{{ pl.m }} z--2 {{ edge }} p--0.5 w--max-[{{ pl.w }}cqw]" data-placard="1">
      <div class="{{ plate }} {{ ppad }} flex flex--col flex--left gap--none">
        <span class="title {{ tcls }} {{ ink }} block text--left" data-clamp="2" data-clamp-lg="2">{{ art.title | escape }}</span>
        {% if pl.who != blank %}<span class="label {{ acls }} {{ ink }} block text--left" data-clamp="1" data-clamp-lg="2">{{ pl.who | escape }}</span>{% endif %}
        {% if pl.detail != blank %}<span class="label {{ dcls }} {{ ink }} block text--left" data-clamp="1" data-clamp-lg="2">{{ pl.detail | escape }}</span>{% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% else %}
{% comment %} mat and ink are pinned (dark: swaps the tokens back) so a dark-mode screen does not repaint the work's mat {% endcomment %}
{% assign gl = gv.gallery %}
{% capture bevel %}
    {% comment %} the picture in a whole-percent sized box on the mat: no outline, the mat alone frames the work (owner 2026-11-17); the picture covers its box {% endcomment %}
    <div class="{{ mat }} w--[{{ gl.a }}cqw] h--[{{ gl.b }}cqh]" data-bevel="1">
      <img src="{{ art.url }}" srcset="{{ art.srcset }}" sizes="{{ gl.a }}vw"{% if block == "backup" %} loading="lazy"{% elsif swap != blank %} onerror="{{ swap }}"{% endif %} class="image image--cover image-dither block w--full h--full" alt="" />
    </div>
{% endcapture %}
<div class="layout layout--col layout--center gap--none p--0 {{ mat }}{% if block == "backup" %} hidden{% endif %}" data-gallery="{{ art.mat }}" data-block="{{ block }}"{% if art.kind == "big" or trmnl.device.model == "frame" %} data-frame="1"{% endif %}>
  {% assign frame = false %}{% if art.kind == "big" or trmnl.device.model == "frame" %}{% assign frame = true %}{% endif %}
  {% if inf %}
  {% comment %} the info is one strip under the work: the work and the strip are one group, centred on the mat; the strip's cap line is a fixed gap under the work {% endcomment %}
  <div class="flex flex--col flex--center-x gap--none w--full" data-info-place="below">
    {{ bevel }}
    <div class="w--full h--[{{ inf.gap }}px]"></div>
    <div class="flex flex--row flex--bottom w--[{{ inf.stripw }}cqw]" data-info-block="below">
      {% render "info", inf:inf, info:info, art:art, ink:ink, frame:frame %}
    </div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x gap--none">
    {{ bevel }}
    {% if gl.label %}
    <div class="flex flex--col flex--right gap--none w--[{{ gl.a }}cqw] {{ lpad }}" data-label="1">
      <span class="title {{ tcls }} {{ ink }} block w--full text--right" data-clamp="{{ gl.label.lines }}" data-clamp-lg="2">{{ art.title | escape }}</span>
      {% if gl.label.who != blank %}<span class="label {{ acls }} {{ ink }} block w--full text--right" data-clamp="1" data-clamp-lg="2">{{ gl.label.who | escape }}</span>{% endif %}
      {% if gl.label.detail != blank %}<span class="label {{ dcls }} {{ ink }} block w--full text--right" data-clamp="1" data-clamp-lg="2">{{ gl.label.detail | escape }}</span>{% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endif %}
{% endtemplate %}

{% template info %}
{% comment %} The info strip: one row on one baseline, three groups in fixed positions (the date at the left, the weather or the agenda in the middle, the museum label at the right), no hairlines, no headings. Three sizes only: the day number, a medium one (weekday and month, temperature, event text, label title) and a small one (forecast, event time, artist line). The Frame (tier f, g) gets Framework sizes by name; the other screens by the tier the transform names from the slot's height in CSS px. Every text span carries its colour class. {% endcomment %}
{% assign tbase = "title" %}
{% case inf.tier %}
{% when "f" %}{% assign tbase = "value" %}{% assign ncls = "value--xxxlarge" %}{% assign mcls = "value--large" %}{% assign scls = "label--xxlarge" %}
{% when "g" %}{% assign tbase = "value" %}{% assign ncls = "value--xxlarge" %}{% assign mcls = "value--base" %}{% assign scls = "label--xlarge" %}
{% when "xl" %}{% assign ncls = "value--xxlarge" %}{% assign mcls = "title--xxlarge" %}{% assign scls = "label--xlarge" %}
{% when "l" %}{% assign ncls = "value--xlarge" %}{% assign mcls = "title--xlarge" %}{% assign scls = "label--large" %}
{% when "m" %}{% assign ncls = "value--large" %}{% assign mcls = "title--base" %}{% assign scls = "label--base" %}
{% else %}{% assign ncls = "value--base" %}{% assign mcls = "title--small" %}{% assign scls = "label--small" %}
{% endcase %}
<div class="flex flex--row flex--bottom w--[{{ inf.lw }}cqw] shrink--0" data-slot="left">
  {% if info.has_date %}
  <div class="flex flex--row flex--bottom gap--medium" data-info="date">
    <span class="value {{ ncls }} {{ ink }} value--tnums" data-day="1">{{ info.day }}</span>
    <div class="flex flex--col flex--left gap--none">
      <span class="{{ tbase }} {{ mcls }} {{ ink }}" data-weekday="1">{{ info.weekday | escape }}</span>
      <span class="{{ tbase }} {{ mcls }} {{ ink }}" data-month="1">{{ info.month | escape }}</span>
    </div>
  </div>
  {% endif %}
</div>
{% if inf.midcols > 0 %}
<div class="flex flex--row flex--bottom gap--large" data-slot="middle">
  {% if info.has_weather %}
  <div class="flex flex--col flex--left gap--none w--[{{ inf.mw }}cqw]" data-info="weather">
    <span class="{{ tbase }} {{ mcls }} {{ ink }} block text--left value--tnums" data-temp="1">{{ info.temp | escape }}</span>
    <span class="label {{ scls }} {{ ink }} block text--left" data-clamp="1" data-clamp-lg="2" data-weather="1">{{ info.weather | escape }}</span>
  </div>
  {% endif %}
  {% if info.has_agenda %}
  {% for ev in info.agenda.items %}
  <div class="flex flex--col flex--left gap--none w--[{{ inf.mw }}cqw]" data-info="agenda" data-event="1" data-agenda="{{ info.agenda.day }}">
    <span class="label {{ scls }} {{ ink }} block text--left value--tnums" data-clamp="1" data-clamp-lg="2" data-event-time="1">{{ ev.time | escape }}</span>
    <span class="{{ tbase }} {{ mcls }} {{ ink }} block text--left" data-clamp="1" data-clamp-lg="2" data-event-title="1">{{ ev.title | escape }}</span>
  </div>
  {% endfor %}
  {% endif %}
</div>
{% endif %}
<div class="flex flex--col flex--right gap--none grow" data-slot="right">
  {% if inf.label %}
  <span class="{{ tbase }} {{ mcls }} {{ ink }} block w--full text--right" data-clamp="1" data-clamp-lg="2" data-label="1">{{ art.title | escape }}</span>
  <span class="label {{ scls }} {{ ink }} block w--full text--right" data-clamp="1" data-clamp-lg="2">{{ inf.who | escape }}</span>
  {% endif %}
</div>
{% endtemplate %}

{% template main %}
{% if art.url %}
{% comment %} The primary block is shown; when its picture fails to load, its onerror hides it and shows the backup block (a second, famous work with its own label, look and mat). If the backup's picture fails too, its mat and label stay: the clean fallback. The swap uses Framework classes only (hidden); no style=. {% endcomment %}
{% assign swap = "" %}
{% if backup.art.url %}{% assign swap = "var v=this.closest('.view')||document,b=v.querySelector('[data-block=backup]'),p=v.querySelector('[data-block=primary]');if(b&&p){p.classList.add('hidden');b.classList.remove('hidden');}" %}{% endif %}
{% render "work", trmnl:trmnl, art:art, geo:geo, info:info, vname:vname, block:"primary", swap:swap %}
{% if backup.art.url %}{% render "work", trmnl:trmnl, art:backup.art, geo:backup.geo, info:info, vname:vname, block:"backup", swap:"" %}{% endif %}
{% else %}
<div class="layout layout--col layout--center">
  <span class="title title--small">Masterworks</span>
  <span class="description">{{ notice | default: "No artwork available right now. The next refresh tries again." }}</span>
</div>
{% endif %}
{% endtemplate %}
